<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget metadata for Split Agenda (Experimental Widget).
    FORK:experimental-widgets

    Size: 4x3 cells (approximately 250dp x 180dp)
    Update: Every 30 minutes (1800000ms)
    Resizable: horizontal and vertical
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="140dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="160dp"
    android:minResizeHeight="90dp"
    android:maxResizeWidth="1100dp"
    android:maxResizeHeight="600dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_loading"
    android:previewLayout="@layout/widget_loading"
    android:description="@string/split_agenda_widget_description"
    android:updatePeriodMillis="1800000"
    android:widgetFeatures="reconfigurable" />
